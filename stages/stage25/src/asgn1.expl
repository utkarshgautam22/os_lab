int main()
{
    decl
        int temp,perm,Filedesc,cnt;
        string FileName;
    enddecl

    begin
        read(FileName);
        read(perm);
        temp = exposcall("Create",FileName,perm);
        Filedesc = exposcall("Open",FileName);
        cnt=0;
        while(cnt < 1100) do
            temp=exposcall("Write",Filedesc,cnt);
            cnt=cnt+1;
        endwhile;
        temp=exposcall("Seek",Filedesc,0);
        cnt=0;
        while(cnt <1100) do
            temp=exposcall("Read",Filedesc,perm);
            cnt=cnt+1;
        endwhile;
        write(perm);

        return 0;
    end
}

