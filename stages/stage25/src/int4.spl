alias userSP R0;
R0=SP;
alias syscall R1;
syscall=[[PTBR+2*((userSP-5)/512)]*512+((userSP-5)%512)];
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+13]=SP;
SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512;

if(syscall==INT_CREATE) then // create syscall

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=R1;

alias FileName R1;
R1=[[PTBR+2*((userSP-4)/512)]*512+((userSP-4)%512)];
alias Permission R2;
R2=[[PTBR+2*((userSP-3)/512)]*512+((userSP-3)%512)];

R3=0;
R4=-1;

while(R3<MAX_FILE_NUM) do // search inode

alias inodeR3 R7;
inodeR3=INODE_TABLE+16*R3; // save inode base

if([inodeR3+1]==FileName) then
break;
endif;

if(R4==-1 && [inodeR3+1]==-1) then
R4=R3;
endif;

R3=R3+1;

endwhile;

if(R3>=60) then

if(R4!=-1) then

alias inodeR4 R7;
inodeR4=INODE_TABLE+16*R4; // save inode base

alias rootR4 R8;
rootR4=ROOT_FILE+8*R4; // save root entry base

[inodeR4]=DATA;
[inodeR4+1]=FileName;
[inodeR4+2]=0;
[inodeR4+3]=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+3];
[inodeR4+4]=Permission;
[inodeR4+8]=-1;
[inodeR4+9]=-1;
[inodeR4+10]=-1;
[inodeR4+11]=-1;

[rootR4]=FileName;
[rootR4+1]=0;
[rootR4+2]=DATA;
[rootR4+3]=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+3];
[rootR4+4]=Permission;

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=0;

else

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1;

endif;

else

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=0;

endif;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
SP=userSP;
ireturn;

endif;

if(syscall==INT_DELETE) then // delete syscall

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=syscall;

alias FileName R1;
R1=[[PTBR+2*((userSP-4)/512)]*512+((userSP-4)%512)];

R3=0;

while(R3<MAX_FILE_NUM) do // search inode

alias inodeR3 R7;
inodeR3=INODE_TABLE+16*R3; // save inode base

if([inodeR3+1]==FileName) then
break;
endif;

R3=R3+1;

endwhile;

if(R3<60) then

alias inodeR3 R7;
inodeR3=INODE_TABLE+16*R3; // reuse inode base

if([inodeR3]==DATA) then

R2=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+3];

if([inodeR3+4]==EXCLUSIVE && R2!=[inodeR3+3] && R2!=1) then

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1;

else
multipush(R0,R1,R2,R3,R7);

R1=ACQUIRE_INODE;
R3=R2;
R2=R3;

call MOD_0;

multipop(R0,R1,R2,R3,R7);

alias fileStatusR3 R8;
fileStatusR3=FILE_STATUS_TABLE+4*R3; // save file status base

if([fileStatusR3+1]==-1) then

R4=0;

while(R4<4) do // release blocks

R6=[inodeR3+8+R4];

if(R6!=-1) then

R5=R6%MAX_BUFFER;

alias bufferR5 R9;
bufferR5=BUFFER_TABLE+4*R5; // save buffer base

if([bufferR5]==R6) then
[bufferR5+1]=0;
endif;

multipush(R0,R1,R2,R3,R4,R7,R9);

R1=RELEASE_BLOCK;
R3=R2;
R2=R6;

call MOD_2;

multipop(R0,R1,R2,R3,R4,R7,R9);

endif;

R4=R4+1;

endwhile;

[inodeR3+1]=-1;

alias rootR3 R8;
rootR3=ROOT_FILE+8*R3; // save root entry base

[rootR3]=-1;

multipush(R0,R1,R2,R3);

R1=RELEASE_INODE;
R3=R2;
R2=R3;

call MOD_0;

multipop(R0,R1,R2,R3);

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=0;

else

multipush(R0,R1,R2,R3);

R1=RELEASE_INODE;
R3=R2;
R2=R3;

call MOD_0;

multipop(R0,R1,R2,R3);

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-2;

endif;

endif;

else

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=-1;

endif;

else

[[PTBR+2*((userSP-1)/512)]*512+((userSP-1)%512)]=0;

endif;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
SP=userSP;
ireturn;

endif;

