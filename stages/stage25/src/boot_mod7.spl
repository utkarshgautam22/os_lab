// ==========================================================
// KERNEL MODULES
// ==========================================================


// Module 0 — Resource Manager
// Disk 53–54 → Pages 40–41

loadi(40,53);
loadi(41,54);


// Module 1 — Process Manager

loadi(42,55);
loadi(43,56);


// Module 2 — Memory Manager

loadi(44,57);
loadi(45,58);


// Module 3 — File Manager

loadi(46,59);
loadi(47,60);


// Module 4 — Device Manager

loadi(48,61);
loadi(49,62);


// Module 5 — Scheduler

loadi(50,63);
loadi(51,64);


// Module 6 — Pager

loadi(52,65);
loadi(53,66);


