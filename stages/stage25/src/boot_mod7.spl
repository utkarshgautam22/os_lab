loadi(55,68);


// ==========================================================
// PROCESS TABLE
// Page 56
// Address: 28672 – 28927
// ==========================================================
R9=0;
while(R9<16) do
    R10=PROCESS_TABLE+4+R9*16;
    [R10]=TERMINATED;
    R9=R9+1;
endwhile;

// ==========================================================
// OPEN FILE TABLE
// Address: 28928 – 29055
// ==========================================================

R0 = 0;

while(R0 < MAX_OPENFILE_NUM) do //32

    [OPEN_FILE_TABLE + R0*4] = -1; 
    [OPEN_FILE_TABLE + R0*4+1] = 0;

    R0 = R0 + 1;

endwhile;



// ==========================================================
// SEMAPHORE TABLE
// Address: 29056 – 29183
// ==========================================================

R0 = 0;

while(R0 < MAX_SEM_COUNT) do

    [SEMAPHORE_TABLE + 4*R0] = -1;
    [SEMAPHORE_TABLE + 4*R0 + 1] = 0;

    R0 = R0 + 1;

endwhile;



// ==========================================================
// MEMORY FREE LIST
// Page 57
// Address: 29184 – 29311
// ==========================================================

R0 = 0;

while(R0 < 84) do

    [MEMORY_FREE_LIST + R0] = 1;

    R0 = R0 + 1;

endwhile;


while(R0 < MAX_MEM_PAGE) do

    [MEMORY_FREE_LIST + R0] = 0;

    R0 = R0 + 1;

endwhile;



// ==========================================================
// FILE STATUS TABLE
// Address: 29312 – 29551
// ==========================================================

R0 = 0;

while(R0 < 60) do

    [FILE_STATUS_TABLE + 4*R0] = -1;
    [FILE_STATUS_TABLE + 4*R0+1] = -1;

    R0 = R0 + 1;

endwhile;



// ==========================================================
// DISK STATUS TABLE
// Address: 29552 – 29559
// ==========================================================

// ==========================================================
// SYSTEM STATUS TABLE
// Address: 29560 – 29567
// ==========================================================

[SYSTEM_STATUS_TABLE + 2] = 44;
[SYSTEM_STATUS_TABLE + 3] = 0;



// ==========================================================
// TERMINAL STATUS TABLE
// Address: 29568 – 29575
// ==========================================================

// ==========================================================
// ACCESS LOCK TABLE
// Address: 29576 – 29583
// ==========================================================

// ==========================================================
// PAGE TABLE
// Page 58
// Address: 29696 – 30015
// ==========================================================

