// Page 58
// Address: 30032 – 30191
// ==========================================================


// ==========================================================
// SYSTEM DATA STRUCTURES (LOADED FROM DISK)
// ==========================================================

// Inode Table
// Pages 59–60
// Address: 30208 – 31167

// User Table
// Pages 59–60
// Address: 31168 - 31199

loadi(59,3);
loadi(60,4);

// Disk Free List
// Page 61
// Address: 31232 – 31743

loadi(61,2);


// Root File
// Page 62
// Address: 31744 – 32223

loadi(62,5);

// ==========================================================
// Expos Library
// ==========================================================
loadi(63,13);
loadi(64,14);

// ==========================================================
// USER SPACE PROGRAMS
// ==========================================================


// INIT / LOGIN
// Pages 65–66
// Address: 33280 – 34303

loadi(65,7);
loadi(66,8);


// SHELL
// Pages 67–68
// Address: 34304 – 35327

loadi(67,9);
loadi(68,10);


// IDLE
// Pages 69–70
// Address: 35328 – 36351

loadi(69,11);
loadi(70,12);

// Buffer Cache
// Pages 71–74
// Address: 36352 – 38399

R0 = 0;


while(R0 < 4) do

    [BUFFER_TABLE + 4*R0] = -1;
    [BUFFER_TABLE + 4*R0+1] = 0;
    [BUFFER_TABLE + 4*R0+2] = -1;

    R0 = R0 + 1;

endwhile;


// ==========================================================
// NON-FIXED MEMORY REGIONS
// ==========================================================


// Reserved Page -- Exam used
// Page 75
// Address: 38400 – 38911


// User Program Area
// Pages 76–127
// Address: 38912 – 65535


// ==========================================================
// INIT PROGRAM SETUP
// ==========================================================
PTBR = PAGE_TABLE_BASE+20;
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";
PTLR=10;
[76*512] = [65*512+1];

[PROCESS_TABLE+15+16] = 10;
[PROCESS_TABLE+14+16] = PTBR;
[PROCESS_TABLE+13+16]=8*512;
[PROCESS_TABLE+16+12]=0;
[PROCESS_TABLE+11+16] = 80;
[PROCESS_TABLE+1+16] = 1;
[PROCESS_TABLE+3+16] = 1;
[PROCESS_TABLE+4+16] = CREATED;

[DISK_MAP_TABLE+1*10]=-1;
[DISK_MAP_TABLE+1*10+1]=-1;
[DISK_MAP_TABLE+1*10+2]=-1;
[DISK_MAP_TABLE+1*10+3]=-1;
[DISK_MAP_TABLE+1*10+4]=7;
[DISK_MAP_TABLE+1*10+5]=8;
[DISK_MAP_TABLE+1*10+6]=-1;
[DISK_MAP_TABLE+1*10+7]=-1;
[DISK_MAP_TABLE+1*10+8]=-1;
[DISK_MAP_TABLE+1*10+9]=-1;

alias PerProcess R5;
PerProcess=[PROCESS_TABLE+16+11]*512+496;
R6=0;
while(R6<8) do
[PerProcess+2*R6]=-1;
R6=R6+2;
endwhile;

[TERMINAL_STATUS_TABLE]=0;
[DISK_STATUS_TABLE]=0;

return;