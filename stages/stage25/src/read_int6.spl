// ===============================
// READ SYSTEM CALL
// MODE_FLAG = 7
// ===============================

// Set MODE_FLAG
[PROCESS_TABLE + 16 * ([SYSTEM_STATUS_TABLE + 1]) + 9] = 7;

// Save USER SP
[PROCESS_TABLE + 16 * ([SYSTEM_STATUS_TABLE + 1]) + 13] = SP;

alias userSP R1;
userSP = SP;

// Switch to kernel stack
SP = [PROCESS_TABLE + 16 * ([SYSTEM_STATUS_TABLE + 1]) + 11] * 512;

// Get arguments
alias fileDiscriptor R2;
fileDiscriptor =
    [[PTBR + 2 * (userSP - 4) / 512] * 512 + (userSP - 4) % 512];

alias word R3;
word =
    [[PTBR + 2 * (userSP - 3) / 512] * 512 + (userSP - 3) % 512];

// ===============================
// TERMINAL READ
// ===============================

if (fileDiscriptor == -1) then

    multipush(R0, R1, R2, R3);

    R1 = TERMINAL_READ;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = word;

    call MOD_4;

    multipop(R0, R1, R2, R3);

    [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = 0;

else

    // ===============================
    // INVALID FILE DESCRIPTOR
    // ===============================
    if (fileDiscriptor > 7 || fileDiscriptor < 0) then

        [[PTBR + 2 * (userSP - 1) / 512] * 512 + (userSP - 1) % 512] = -1;

    else

        // ===============================
        // GET PER PROCESS ENTRY
        // ===============================
        alias PerProcessEntry R4;

        PerProcessEntry =
            [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 +
            RESOURCE_TABLE_OFFSET +
            2 * fileDiscriptor;

        // Check valid file
        if ([PerProcessEntry] != FILE) then

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + ((userSP - 1) % 512)] = -1;

        else

            // ===============================
            // OPEN FILE TABLE ENTRY
            // ===============================

            alias FileTableEntry R5;

            FileTableEntry =
                OPEN_FILE_TABLE + 4 * [PerProcessEntry + 1];

            alias InodeIdx R6;
            InodeIdx = [FileTableEntry];

            // Acquire inode
            multipush(R1, R2, R3, R4, R5, R6);

            R1 = ACQUIRE_INODE;
            R2 = InodeIdx;
            R3 = [SYSTEM_STATUS_TABLE + 1];

            call MOD_0;

            multipop(R1, R2, R3, R4, R5, R6);

            // ===============================
            // ROOT FILE READ
            // ===============================

            if (InodeIdx == INODE_ROOT) then
                if ([FileTableEntry + 2] == 480) then

                    multipush(R1, R2, R3, R4, R5, R6);

                    R1 = RELEASE_INODE;
                    R2 = InodeIdx;
                    R3 = [SYSTEM_STATUS_TABLE + 1];

                    call MOD_0;

                    multipop(R1, R2, R3, R4, R5, R6);

                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + ((userSP - 1) % 512)] = -2;

                else
                    R9=[PTBR + 2 * word / 512];
                    R8=word % 512;

                    [R9*512 + R8] = [ROOT_FILE + [FileTableEntry + 2]];
                    [FileTableEntry + 2] = [FileTableEntry + 2] + 1;

                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + ((userSP - 1) % 512)] = 0;

                endif;

            // ===============================
            // NORMAL FILE READ
            // ===============================

            else

                if ([FileTableEntry + 2] == [INODE_TABLE + 16 * InodeIdx + 2]) then

                    multipush(R1, R2, R3, R4, R5, R6);

                    R1 = RELEASE_INODE;
                    R2 = InodeIdx;
                    R3 = [SYSTEM_STATUS_TABLE + 1];

                    call MOD_0;

                    multipop(R1, R2, R3, R4, R5, R6);

                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + ((userSP - 1) % 512)] = -2;

                else

                    multipush(R1, R2, R3, R4, R5,R6);

                    R2 =
                        [INODE_TABLE +
                         16 * InodeIdx +
                         8 +
                         [FileTableEntry + 2] / 512];

                    R4 = word;

                    R1 = BUFFERED_READ;

                    R3 = [FileTableEntry + 2] % 512;

                    call MOD_3;

                    multipop(R1, R2, R3, R4, R5,R6);

                    [FileTableEntry + 2] = [FileTableEntry + 2] + 1;

                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512 + ((userSP - 1) % 512)] = 0;

                endif;

            endif;

            // ===============================
            // RELEASE INODE
            // ===============================

            multipush(R1, R2, R3, R4, R5,R6);

            R1 = RELEASE_INODE;
            R2 = InodeIdx;
            R3 = [SYSTEM_STATUS_TABLE + 1];

            call MOD_0;

            multipop(R1, R2, R3, R4, R5,R6);

        endif;
    endif;
endif;

// ===============================
// RESTORE USER CONTEXT
// ===============================

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

SP = userSP;

ireturn;
