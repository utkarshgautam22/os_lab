int main()
{
    decl
        int temp;
        int pid,fd;
        string FileName;
    enddecl

    begin
        //FileName="numbers.dat";
        read(FileName);
        fd = exposcall("Open",FileName);
        pid = exposcall("Read",fd,temp);
        write(temp);
        pid = exposcall("Read",fd,temp);
        write(temp);
        pid = exposcall("Read",fd,temp);
        write(temp);
        pid = exposcall("Read",fd,temp);
        write(temp);
        pid = exposcall("Read",fd,temp);
        write(temp);
        return 0;
    end
}

