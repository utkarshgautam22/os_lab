// ================= ENTER KERNEL =================

// Save user SP
alias userSP R0;
R0 = SP;

// Get syscall number from user stack
alias syscall R1;
syscall =
    [[PTBR + 2 * ((userSP - 5) / 512)] * 512
        + ((userSP - 5) % 512)];

// Save USER SP into process table
[PROCESS_TABLE
    + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

// Switch to kernel stack
SP =
    [PROCESS_TABLE
        + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512;


R10=PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 ;
// ======================================================
// ================= CREATE SYSTEM CALL =================
// ======================================================

if (syscall == INT_CREATE) then

    // Set MODE_FLAG = 1 (CREATE)
    [R10+ 9] = R1;



    // ================= GET ARGUMENTS =================

    alias FileName R1;
    FileName =
        [[PTBR + 2 * ((userSP - 4) / 512)] * 512
            + ((userSP - 4) % 512)];

    alias Permission R2;
    Permission =
        [[PTBR + 2 * ((userSP - 3) / 512)] * 512
            + ((userSP - 3) % 512)];



    // ================= SEARCH INODE TABLE =================

    R3 = 0;      // index
    R4 = -1;     // free inode index

    while (R3 < MAX_FILE_NUM) do

        alias inodeR3 R7;
        inodeR3 = INODE_TABLE + 16 * R3;



        // File already exists
        if ([inodeR3 + 1] == FileName) then
            break;
        endif;



        // Remember first free inode
        if (R4 == -1 && [inodeR3 + 1] == -1) then
            R4 = R3;
        endif;

        R3 = R3 + 1;

    endwhile;



    // ================= FILE NOT FOUND =================

    if (R3 >= MAX_FILE_NUM) then

        // Free inode available
        if (R4 != -1) then

            alias inodeR4 R7;
            inodeR4 = INODE_TABLE + 16 * R4;

            alias rootR4 R8;
            rootR4 = ROOT_FILE + 8 * R4;



            // Initialize inode entry

            [inodeR4]     = DATA;      // file type
            [inodeR4 + 1] = FileName;  // file name
            [inodeR4 + 2] = 0;         // file size

            // user id
            [inodeR4 + 3] =[R10 + 3];

            [inodeR4 + 4] = Permission;



            // Initialize block numbers

            [inodeR4 + 8]  = -1;
            [inodeR4 + 9]  = -1;
            [inodeR4 + 10] = -1;
            [inodeR4 + 11] = -1;



            // ================= CREATE ROOT ENTRY =================

            [rootR4]     = FileName;
            [rootR4 + 1] = 0;          // size
            [rootR4 + 2] = DATA;
            [rootR4 + 3] = [USER_TABLE +2*[R10 + 3]];
            [rootR4 + 4] = Permission;



            // Return success

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = 0;

        else

            // No free inode

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = -1;

        endif;



    else

        // File already exists

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = 0;

    endif;



    // ================= EXIT CREATE =================

    [PROCESS_TABLE
        + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    SP = userSP;

    ireturn;

endif;



// ======================================================
// ================= DELETE SYSTEM CALL =================
// ======================================================

if (syscall == INT_DELETE) then

    // Set MODE_FLAG = DELETE
    [R10 + 9] = syscall;



    // ================= GET ARGUMENT =================

    alias FileName R1;

    FileName =
        [[PTBR + 2 * ((userSP - 4) / 512)] * 512
            + ((userSP - 4) % 512)];



    // ================= SEARCH INODE =================

    R3 = 0;

    while (R3 < MAX_FILE_NUM) do

        alias inodeR3 R7;
        inodeR3 = INODE_TABLE + 16 * R3;

        if ([inodeR3 + 1] == FileName) then
            break;
        endif;

        R3 = R3 + 1;

    endwhile;



    if (R3 < 60) then

        alias inodeR3 R7;
        inodeR3 = INODE_TABLE + 16 * R3;



        // Ensure file type is DATA

        if ([inodeR3] == DATA) then

            R2 =[R10 + 3];



            // Permission check

            if (
                [inodeR3 + 4] == EXCLUSIVE
                &&
                R2 != [inodeR3 + 3]
                &&
                R2 != 1
            ) then

                // Access denied

                [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                    + ((userSP - 1) % 512)] = -1;

            else



                // ================= ACQUIRE INODE LOCK =================

                multipush(R0, R1, R2, R3, R7);

                R1 = ACQUIRE_INODE;
                R2 = R3;
                R3 = [SYSTEM_STATUS_TABLE + 1];
                

                call MOD_0;

                multipop(R0, R1, R2, R3, R7);



                alias fileStatusR3 R8;

                fileStatusR3 =
                    FILE_STATUS_TABLE + 4 * R3;



                // File not open

                if ([fileStatusR3 + 1] == -1) then



                    // ================= RELEASE BLOCKS =================

                    R4 = 0;

                    while (R4 < 4) do

                        R6 =
                            [inodeR3 + 8 + R4];



                        if (R6 != -1) then

                            R5 =
                                R6 % MAX_BUFFER;

                            alias bufferR5 R9;

                            bufferR5 =
                                BUFFER_TABLE + 4 * R5;



                            // Clear dirty flag

                            if ([bufferR5] == R6) then
                                [bufferR5 + 1] = 0;
                            endif;



                            multipush(
                                R0, R1, R2,
                                R3, R4, R7, R9
                            );

                            R1 = RELEASE_BLOCK;
                            R3 = R2;
                            R2 = R6;

                            call MOD_2;

                            multipop(
                                R0, R1, R2,
                                R3, R4, R7, R9
                            );

                        endif;

                        R4 = R4 + 1;

                    endwhile;



                    // ================= DELETE FILE =================

                    [inodeR3 + 1] = -1;



                    alias rootR3 R8;

                    rootR3 =
                        ROOT_FILE + 8 * R3;

                    [rootR3] = -1;



                    // Release inode lock

                    multipush(R0, R1, R2, R3);

                    R1 = RELEASE_INODE;
                    R2 = R3;
                    R3 = [SYSTEM_STATUS_TABLE + 1];
                    

                    call MOD_0;

                    multipop(R0, R1, R2, R3);



                    // Success

                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                        + ((userSP - 1) % 512)] = 0;

                else

                    // File is open

                    multipush(R0, R1, R2, R3);

                    R1 = RELEASE_INODE;
                    R2 = R3;
                    R3 = [SYSTEM_STATUS_TABLE + 1];
                    

                    call MOD_0;

                    multipop(R0, R1, R2, R3);



                    [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                        + ((userSP - 1) % 512)] = -2;

                endif;

            endif;

        else

            // Not a data file

            [[PTBR + 2 * ((userSP - 1) / 512)] * 512
                + ((userSP - 1) % 512)] = -1;

        endif;

    else

        // File not found

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = 0;

    endif;



    // ================= EXIT DELETE =================

    [PROCESS_TABLE
        + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

    SP = userSP;

    ireturn;

endif;