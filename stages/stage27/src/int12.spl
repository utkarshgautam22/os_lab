alias userSP R1;
userSP = SP;

alias ProcessTable R2;
ProcessTable = PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE + 1];

alias syscall R3;
syscall =
    [[PTBR + 2 * ((userSP - 5) / 512)] * 512
        + ((userSP - 5) % 512)];


// Switch to Kernel Stack

[ProcessTable + 13] = userSP;
SP = [ProcessTable + 11] * 512;



alias pid R6;
pid = [SYSTEM_STATUS_TABLE + 1];



if (syscall == INT_LOGOUT) then     // 28

    // Set MODE_FLAG
    [ProcessTable + 9] = INT_LOGOUT;



    // Only shell (PID 2) can logout

    if ([SYSTEM_STATUS_TABLE + 1] == 2) then



        // Kill all user processes except shell

        multipush(R1, R2);

        R1 = KILL_ALL;
        R2 = [SYSTEM_STATUS_TABLE + 1];

        call MOD_1;

        multipop(R1, R2);



        // Set current process (shell) to TERMINATED

        [ProcessTable + 4] = TERMINATED;



        // Load shell entry point to stack

        R4 = [PTBR + 2 * 4];
        R5 = [PTBR + 2 * 8];

        [R5 * 512] = [R4 * 512 + 1];



        // Reset USER SP to 4096

        [ProcessTable + 13] = 4096;



        // Wake up Login process (PID 1)

        [PROCESS_TABLE + 1 * 16 + 4] = READY;



        // Reset CURRENT_USER_ID to kernel (0)

        [SYSTEM_STATUS_TABLE] = 0;



        breakpoint;



        // Invoke scheduler

        multipush(R1, R2);

        call MOD_5;

        multipop(R1, R2);



    else

        // Not shell → error

        [[PTBR + 2 * ((userSP - 1) / 512)] * 512
            + ((userSP - 1) % 512)] = -1;

    endif;



    // Exit syscall

    [ProcessTable + 9] = 0;

    SP = userSP;

    ireturn;

endif;