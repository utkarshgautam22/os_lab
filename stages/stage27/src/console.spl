// Save user stack pointer
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 13] = SP;

// Switch to kernel stack
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11] * 512 - 1;

// Save CPU register context
backup;



// Mark terminal device as free
[TERMINAL_STATUS_TABLE + 0] = 0;



alias reqPID R2;

// Get PID of process that performed read
reqPID = [TERMINAL_STATUS_TABLE + 1];



// Copy input from terminal port to process input buffer
[PROCESS_TABLE + 16 * reqPID + 8] = P0;



// Release terminal lock via Resource Manager
multipush(R1,R2,R3);

    R1 = 9;
    R2 = reqPID;
    call MOD_0;

multipop(R1,R2,R3);



// Restore CPU register context
restore;

// Restore user stack pointer
SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 13];

// Return from interrupt
ireturn;