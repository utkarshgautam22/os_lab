alias functionNum R1;
alias currentPID R2;
if(functionNum==3) then

    // Acquire terminal device lock
    multipush(R1,R2,R3);
        R1 = 8;
        R2 = [SYSTEM_STATUS_TABLE+1];
        call MOD_0;
    multipop(R1,R2,R3);

    // Print word to terminal
    print R3;

    // Release terminal device lock
    multipush(R1,R2,R3);
        R1 = 9;
        R2 = [SYSTEM_STATUS_TABLE+1];
        call MOD_0;
    multipop(R1,R2,R3);

    return;

endif;



if(functionNum==4) then

    // Acquire terminal device lock
    multipush(R1,R2,R3);
        R1 = 8;
        R2 = [SYSTEM_STATUS_TABLE+1];
        call MOD_0;
    multipop(R1,R2,R3);

    // Read word from terminal
    read;

    // Block process until terminal interrupt completes
    [PROCESS_TABLE+16*currentPID+4] = WAIT_TERMINAL;

    // Switch to scheduler
    multipush(R1,R2,R3);
        call MOD_5;
    multipop(R1,R2,R3);

    // Copy received word from input buffer to user memory
    [[PTBR+2*R3/512]*512+R3%512] =
        [PROCESS_TABLE+16*currentPID+8];

    return;

endif;



if(functionNum==2) then

    // Acquire disk device lock
    multipush(R1,R2,R3,R4);
        R1 = 3;
        R2 = currentPID;
        call MOD_0;
    multipop(R1,R2,R3,R4);

    // Set disk operation parameters
    [DISK_STATUS_TABLE+1] = 0;     // LOAD operation
    [DISK_STATUS_TABLE+2] = R3;    // Page number
    [DISK_STATUS_TABLE+3] = R4;    // Block number

    // Load block from disk to memory page
    load(R3,R4);

    // Block process until disk interrupt completes
    [PROCESS_TABLE+16*currentPID+4] = WAIT_DISK;

    // Switch to scheduler
    multipush(R1,R2,R3,R4);
        call MOD_5;
    multipop(R1,R2,R3,R4);

    return;

endif;



if(functionNum==1) then
    // Acquire disk device lock
    multipush(R1,R2,R3,R4);
        R1 = 3;
        R2 = currentPID;
        call MOD_0;
    multipop(R1,R2,R3,R4);

    // Set disk operation parameters
    [DISK_STATUS_TABLE+1] = 1;     // STORE operation
    [DISK_STATUS_TABLE+2] = R3;    // Page number
    [DISK_STATUS_TABLE+3] = R4;    // Block number

    // Store memory page to disk block
    store(R3,R4);

    // Block process until disk interrupt completes
    [PROCESS_TABLE+16*currentPID+4] = WAIT_DISK;

    // Switch to scheduler
    multipush(R1,R2,R3,R4);
        call MOD_5;
    multipop(R1,R2,R3,R4);

    return;

endif;