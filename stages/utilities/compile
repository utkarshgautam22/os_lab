#!/bin/bash
EXPL_DIR="/home/ug/Desktop/myexpos/expl"
STAGE_DIR="/home/ug/Desktop/myexpos/stages/utilities"

# Compile EXPL files
if [ -d "$EXPL_DIR" ]; then
    cd "$EXPL_DIR" || exit 1
    for file in "$STAGE_DIR"/*.expl; do
        if [ -f "$file" ]; then
            output=$(./expl "$file" 2>&1)
            if [ -n "$output" ]; then
                echo "$output"
                echo "$file"
            fi
        fi
    done
fi
