int main()
{
	decl
		int fd,ret,p;
		string username;
		string name;
		string owner;
	enddecl
	begin
		read(username);
        fd=exposcall("Open","root");
        ret=0;
        if(fd>=0) then
            while(ret == 0) do
                ret=exposcall("Read",fd,name);
                p=exposcall("Seek",fd,2);
                ret=exposcall("Read",fd,owner);
                if(ret == 0) then
                    if(owner == username) then
                        ret = exposcall("Delete",name);
                    endif;
                    ret=exposcall("Seek",fd,4);
                endif;
            endwhile;
            fd=exposcall("Close",fd);
        else
            write("not open");
        endif;
		return 0;
	end
}
