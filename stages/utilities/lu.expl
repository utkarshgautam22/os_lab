int main()
{
	decl
		int id;
        string username;
	enddecl
	begin
        id = 0;
        while (id < 16) do
            username = exposcall("Getuname",id);
            if(username != "-1") then
                write(username);
            endif;
            id = id + 1;
        endwhile;
		return 0;
	end
}
