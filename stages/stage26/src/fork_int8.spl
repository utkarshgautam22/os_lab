// ================= ENTER KERNEL MODE =================

// Set MODE_FLAG = 8  (process is inside fork system call)
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 8;

// Save USER SP
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

// Switch to kernel stack
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;



// ================= GET NEW PROCESS TABLE ENTRY =================

R1 = 1;
call MOD_1;              // get_pcb_entry()

alias newpid R2;
R2 = R0;                 // child PID

alias pid R3;
R3 = [SYSTEM_STATUS_TABLE + 1];   // parent PID

alias userSP R1;
userSP =
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];



// ================= IF PCB AVAILABLE =================

if (newpid != -1) then



    // ================= ENSURE PARENT HEAP EXISTS =================

    if ([PTBR + 4] == -1) then

        multipush(R1, R2, R3);

        // Allocate heap page 1
        R1 = 1;
        call MOD_2;

        multipop(R1, R2, R3);

        [PTBR + 4] = R0;
        [PTBR + 5] = "1110";

        multipush(R1, R2, R3);

        // Allocate heap page 2
        R1 = 1;
        call MOD_2;

        [PTBR + 6] = R0;
        [PTBR + 7] = "1110";

        multipop(R1, R2, R3);

    endif;



    // ================= ALLOCATE CHILD STACK + UA PAGE =================

    multipush(R1, R2, R3, R4);

    R1 = 1;
    call MOD_2;

    multipop(R1, R2, R3, R4);

    // Child stack page 1
    [PAGE_TABLE_BASE + 20 * newpid + 16] = R0;
    [PAGE_TABLE_BASE + 20 * newpid + 17] = "0110";



    multipush(R1, R2, R3, R4);

    R1 = 1;
    call MOD_2;

    multipop(R1, R2, R3, R4);

    // Child stack page 2
    [PAGE_TABLE_BASE + 20 * newpid + 18] = R0;
    [PAGE_TABLE_BASE + 20 * newpid + 19] = "0110";



    multipush(R1, R2, R3, R4);

    R1 = 1;
    call MOD_2;

    multipop(R1, R2, R3, R4);

    // User Area Page
    [PROCESS_TABLE + 16 * newpid + 11] = R0;



    // Save BP at start of kernel stack
    [R0 * 512] = BP;



    // ================= COPY PROCESS TABLE FIELDS =================

    alias ChildProcessTable R4;
    ChildProcessTable =
        PROCESS_TABLE + 16 * newpid;

    alias PrntProcessTable R5;
    PrntProcessTable =
        PROCESS_TABLE + 16 * pid;



    // Copy shared fields
    [ChildProcessTable + 3]  = [PrntProcessTable + 3];
    [ChildProcessTable + 6]  = [PrntProcessTable + 6];
    [ChildProcessTable + 10] = [PrntProcessTable + 10];
    [ChildProcessTable + 7]  = [PrntProcessTable + 7];
    [ChildProcessTable + 13] = [PrntProcessTable + 13];



    // Reset runtime fields
    [ChildProcessTable + 9]  = 0;        // MODE
    [ChildProcessTable + 12] = 0;        // TICK
    [ChildProcessTable]      = 0;        // STATE

    // Set parent PID
    [ChildProcessTable + 2]  = pid;

    // Set state
    [ChildProcessTable + 4]  = CREATED;



    // ================= COPY PER-PROCESS RESOURCE TABLE =================

    alias ChildPerProcess R4;
    ChildPerProcess =
        [PROCESS_TABLE + 16 * newpid + 11] * 512 + 496;

    alias PrntPerProcess R5;
    PrntPerProcess =
        [PROCESS_TABLE + 16 * pid + 11] * 512 + 496;



    R6 = 0;

    while (R6 < 16) do

        // Copy entry
        [ChildPerProcess + R6]     =
            [PrntPerProcess + R6];

        [ChildPerProcess + R6 + 1] =
            [PrntPerProcess + R6 + 1];



        // Semaphore reference count
        if ([PrntPerProcess + R6] == 1) then

            [SEMAPHORE_TABLE
                + 4 * [PrntPerProcess + R6 + 1] + 1]
            =
            [SEMAPHORE_TABLE
                + 4 * [PrntPerProcess + R6 + 1] + 1] + 1;

        endif;



        // File reference count
        if ([PrntPerProcess + R6] == FILE) then

            [OPEN_FILE_TABLE
                + 4 * [PrntPerProcess + R6 + 1] + 1]
            =
            [OPEN_FILE_TABLE
                + 4 * [PrntPerProcess + R6 + 1] + 1] + 1;

        endif;

        R6 = R6 + 2;

    endwhile;



    // ================= COPY DISK MAP TABLE =================

    R6 = 0;

    while (R6 < 10) do

        [DISK_MAP_TABLE + newpid * 10 + R6] =
            [DISK_MAP_TABLE + pid * 10 + R6];

        R6 = R6 + 1;

    endwhile;



    // ================= COPY PAGE TABLE (SHARED PAGES) =================

    R6 = 0;

    while (R6 < 16) do

        [PAGE_TABLE_BASE + 20 * newpid + R6] =
            [PAGE_TABLE_BASE + 20 * pid + R6];

        [PAGE_TABLE_BASE + 20 * newpid + R6 + 1] =
            [PAGE_TABLE_BASE + 20 * pid + R6 + 1];



        // Increment reference count
        if ([PAGE_TABLE_BASE + 20 * newpid + R6] != -1) then

            [MEMORY_FREE_LIST
                + [PAGE_TABLE_BASE + 20 * newpid + R6]]
            =
            [MEMORY_FREE_LIST
                + [PAGE_TABLE_BASE + 20 * newpid + R6]] + 1;

        endif;

        R6 = R6 + 2;

    endwhile;



    // ================= COPY USER STACK =================

    // Stack page 1

    R4 =
        [PAGE_TABLE_BASE + 20 * newpid + 16] * 512;

    R5 =
        [PAGE_TABLE_BASE + 20 * pid + 16] * 512;

    R6 = 0;

    while (R6 < 512) do

        [R4] = [R5];

        R4 = R4 + 1;
        R5 = R5 + 1;

        R6 = R6 + 1;

    endwhile;



    // Stack page 2

    R4 =
        [PAGE_TABLE_BASE + 20 * newpid + 18] * 512;

    R5 =
        [PAGE_TABLE_BASE + 20 * pid + 18] * 512;

    R6 = 0;

    while (R6 < 512) do

        [R4] = [R5];

        R4 = R4 + 1;
        R5 = R5 + 1;

        R6 = R6 + 1;

    endwhile;



    // ================= RETURN VALUES =================

    // Parent gets child PID
    [[PTBR + 2 * (userSP - 1) / 512] * 512
        + (userSP - 1) % 512]
        = newpid;

    // Child gets 0
    [[PAGE_TABLE_BASE + 20 * newpid
        + 2 * (userSP - 1) / 512] * 512
        + (userSP - 1) % 512]
        = 0;



else

    // No PCB available
    [[PTBR + 2 * (userSP - 1) / 512] * 512
        + (userSP - 1) % 512]
        = -1;

endif;



// ================= EXIT KERNEL =================

// Reset MODE_FLAG
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

// Restore user stack
SP = userSP;

// Return to user mode
ireturn;