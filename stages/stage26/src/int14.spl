alias userSP R1;
R1 = SP;

alias syscall R2;

// Get syscall number from user stack
syscall = [[PTBR + 2*((userSP-5)/512)]*512 + ((userSP-5)%512)];

// Save user SP
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 13] = SP;

// Switch to kernel stack
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 11]*512;


// =========================
// SEMLOCK (19)
// =========================

if (syscall == 19) then

    // Set MODE_FLAG
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 19;

    alias semid R4;

    // Get semaphore descriptor from user stack
    R2 = [[PTBR + 2*((userSP-4)/512)]*512 + ((userSP-4)%512)];

    // Current PID
    R3 = [SYSTEM_STATUS_TABLE+1];

    alias PerProcess R5;

    // Address of per-process semaphore table
    PerProcess = [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 11]*512 + 496;

    // Validate descriptor
    if (R2 > 7 || R2 < 0 || [PerProcess + 2*R2] != 1) then

        // Return -1 : invalid descriptor
        [[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512)] = -1;

    else

        // Get semaphore table index
        R4 = [PerProcess + 2*R2 + 1];

        // Wait until semaphore becomes free or already owned
        while ([SEMAPHORE_TABLE + 4*R4] != -1 &&
               [SEMAPHORE_TABLE + 4*R4] != R3) do

            // Put process into WAIT state
            [PROCESS_TABLE + 16*R3 + 4] = WAIT_SEMAPHORE;

            // Store semaphore index
            [PROCESS_TABLE + 16*R3 + 5] = R4;

            // Call scheduler
            multipush(R1, R2, R3, R4);
            call MOD_5;
            multipop(R1, R2, R3, R4);

        endwhile;

        // Acquire lock
        [SEMAPHORE_TABLE + 4*R4] = R3;

        // Return success
        [[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512)] = 0;

    endif;

endif;


// =========================
// SEMUNLOCK (20)
// =========================

if (syscall == 20) then

    // Set MODE_FLAG
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 20;

    // Get semaphore descriptor
    R2 = [[PTBR + 2*((userSP-4)/512)]*512 + ((userSP-4)%512)];

    // Current PID
    R3 = [SYSTEM_STATUS_TABLE+1];

    alias PerProcess R5;

    // Address of per-process semaphore table
    PerProcess = [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 11]*512 + 496;

    // Validate descriptor
    if (R2 > 7 || R2 < 0 || [PerProcess + 2*R2] != 1) then

        // Return -1 : invalid descriptor
        [[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512)] = -1;

    else

        // Get semaphore table index
        R4 = [PerProcess + 2*R2 + 1];

        // Check ownership
        if ([SEMAPHORE_TABLE + 4*R4] != R3) then

            // Return -2 : not owner
            [[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512)] = -2;

        else

            // Release lock
            [SEMAPHORE_TABLE + 4*R4] = -1;

            // Wake waiting processes
            R5 = 0;

            while (R5 < 16) do

                if ([PROCESS_TABLE + 16*R5 + 4] == WAIT_SEMAPHORE &&
                    [PROCESS_TABLE + 16*R5 + 5] == R4) then

                    [PROCESS_TABLE + 16*R5 + 4] = READY;

                endif;

                R5 = R5 + 1;

            endwhile;

            // Return success
            [[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512)] = 0;

        endif;

    endif;

endif;


// Reset MODE_FLAG
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9] = 0;

// Restore user stack
SP = userSP;

ireturn;