// Function number alias
alias functionNum R1;

// ================= BUFFERED_READ/BUFFERED_WRITE =================
if (functionNum == BUFFERED_READ || functionNum == BUFFERED_WRITE) then // 2

    alias block R2;
    alias offset R3;
    alias address R4;

    multipush(R1, R2, R3, R4);

    R1 = ACQUIRE_BUFFER;
    R2 = R2 % 4;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call MOD_0;
    multipop(R1, R2, R3, R4);
    
    if ([BUFFER_TABLE + 4 * (R2 % 4)] != R2) then

        if ([BUFFER_TABLE + 4 * (R2 % 4) + 1] == 1) then

            multipush(R1, R2, R3, R4);

            R4 = [BUFFER_TABLE + 4 * (R2 % 4)];
            R1 = DISK_STORE;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = 71 + (R2 % 4);

            call MOD_0;

            multipop(R1, R2, R3, R4);

            [BUFFER_TABLE + 4 * (R2 % 4)] = -1;
            [BUFFER_TABLE + 4 * (R2 % 4) + 1] = 0;

        endif;

        multipush(R1, R2, R3, R4);

        R4 = R2;
        R1 = DISK_LOAD;
        R3 = 71 + (R2 % 4);
        R2 = [SYSTEM_STATUS_TABLE + 1];
        call MOD_4;

        multipop(R1, R2, R3, R4);

        [BUFFER_TABLE + 4 * (R2 % 4)] = R2;
        [BUFFER_TABLE + 4 * (R2 % 4) + 1] = 0;

    endif;

    if(functionNum==BUFFERED_WRITE) then
        [(71 + (R2 % 4))*512+offset]=address;
        [BUFFER_TABLE+4*(R2%4)+1]=1;
    else
        R5=[(71 + (R2 % 4))*512+offset];
        [[PTBR+2*address/512]*512+address%512]= R5;
    endif;

    multipush(R1, R2, R3, R4);

    R1 = RELEASE_BUFFER;
    R2 = R2 % 4;
    R3 = [SYSTEM_STATUS_TABLE + 1];

    call MOD_0;

    multipop(R1, R2, R3, R4);
    
    return;

endif;


// ================= OPEN =================
if (functionNum == OPEN) then // 3
    alias FileName R2;
    R3 = 0;
    // Search inode
    while (R3 < MAX_FILE_NUM) do

        if ([INODE_TABLE + 16 * R3 + 1] == FileName) then
            break;
        endif;

        R3 = R3 + 1;

    endwhile;

    if (R3 < MAX_FILE_NUM) then

        multipush(R1, R2, R3);

        R1 = ACQUIRE_INODE;
        R2 = R3;
        R3 = [SYSTEM_STATUS_TABLE + 1];

        call MOD_0;

        multipop(R1, R2, R3);
        if (R0 == -1) then

            R0 = -1;

        else

            if ([INODE_TABLE + 16 * R3] == EXEC) then

                multipush(R1, R2, R3);

                R1 = RELEASE_INODE;
                R2 = R3;
                R3 = [SYSTEM_STATUS_TABLE + 1];

                call MOD_0;

                multipop(R1, R2, R3);

                R0 = -1;

            else

                R4 = 0;

                while (R4 < MAX_OPENFILE_NUM) do

                    if ([OPEN_FILE_TABLE + 4 * R4] == -1) then
                        break;
                    endif;

                    R4 = R4 + 1;

                endwhile;

                if (R4 < MAX_OPENFILE_NUM) then

                    if (FileName == "root") then

                        [OPEN_FILE_TABLE + 4 * R4] = INODE_ROOT;

                    else
                        [OPEN_FILE_TABLE + 4 * R4 ] = R3;
                        if ([FILE_STATUS_TABLE + R3 + 1] == -1) then
                            [FILE_STATUS_TABLE + 4 * R3 + 1] = 1;
                        else
                            [FILE_STATUS_TABLE + 4 * R3 + 1] =
                                [FILE_STATUS_TABLE + R3 + 1] + 1;
                        endif;

                    endif;

                    [OPEN_FILE_TABLE + 4 * R4 + 1] = 1;
                    [OPEN_FILE_TABLE + 4 * R4 + 2] = 0;

                    R0 = R4;

                else

                    R0 = -2;

                endif;

                multipush(R0, R1, R2, R3);

                R1 = RELEASE_INODE;
                R2 = R3;
                R3 = [SYSTEM_STATUS_TABLE + 1];

                call MOD_0;

                multipop(R0, R1, R2, R3);

            endif;

        endif;

    else

        R0 = -1;

    endif;

    return;

endif;


// ================= CLOSE =================
if (functionNum == CLOSE) then // 4

    alias FileTableEntry R3;

    FileTableEntry = OPEN_FILE_TABLE + 4 * R2;

    [FileTableEntry + 1] =
        [FileTableEntry + 1] - 1;

    if ([FileTableEntry + 1] == 0) then

        [FileTableEntry + 1] = -1;
        [FileTableEntry + 2] = -1;

        alias fileStatus R4;

        fileStatus =
            FILE_STATUS_TABLE + 4 * [FileTableEntry];

        if ([INODE_TABLE + 16 * [FileTableEntry] + 1] != "root") then
            [fileStatus + 1] =
                [fileStatus + 1] - 1;
        endif;

        if ([fileStatus + 1] == 0) then
            [fileStatus] = -1;
        endif;

        [FileTableEntry] = -1;

    endif;

    return;

endif;