if(R1==2) then
    // Decrement share count of the given memory page
    [MEMORY_FREE_LIST+R2]=[MEMORY_FREE_LIST+R2]-1;

    if([MEMORY_FREE_LIST+R2]==0 && R2>80) then
        // Page became completely free, update free page count
        [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]+1;
    endif;

    R3=1;

    // Wake up processes waiting for memory
    while(R3<16) do
        if([PROCESS_TABLE+16*R3+4] == WAIT_MEM) then
            [PROCESS_TABLE+16*R3+4]=READY;
        endif;
        R3=R3+1;
    endwhile;

    return;
endif;

if(R1==1) then
    // Increase number of processes waiting for memory
    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]+1;

    // Wait until a free memory page becomes available
    while([SYSTEM_STATUS_TABLE+2]==0) do
        // Put current process into WAIT_MEM state
        [PROCESS_TABLE+16*[SYSTEM_STATUS_TABLE+1]+4]=WAIT_MEM;

        multipush(R1,R2,R3);
        // Switch context to scheduler
        call MOD_5;
        multipop(R1,R2,R3);
    endwhile;

    // Memory is now available, update counters
    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]-1;
    [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;

    R3=81;

    // Search for a free physical page
    while(R3<128) do
        if([MEMORY_FREE_LIST+R3]==0) then
            // Allocate the page
            [MEMORY_FREE_LIST+R3]=1;
            R0=R3;
            break;
        endif;
        R3=R3+1;
    endwhile;

    return;
endif;

if(R1==5) then
    R5=0;

    // Check if requested code block already exists in memory
    while(R5<16) do
        R4=0;

        while(R4<4) do
            if([DISK_MAP_TABLE+10*R5+4+R4]==R2) then
                if([PAGE_TABLE_BASE+20*R5+2*R4+8]!=-1) then
                    // Code page already loaded, increase share count
                    R0=[PAGE_TABLE_BASE+20*R5+2*R4+8];
                    [MEMORY_FREE_LIST+R0]=[MEMORY_FREE_LIST+R0]+1;
                    return;
                endif;
            endif;
            R4=R4+1;
        endwhile;

        R5=R5+1;
    endwhile;

    // Allocate new memory page
    multipush(R1,R2,R3);
    R1=1;
    call MOD_2;
    multipop(R1,R2,R3);

    multipush(R0,R1,R2,R3);

    // Load code block from disk into memory
    R1=2;
    R4=R2;
    R2=[SYSTEM_STATUS_TABLE+1];
    R3=R0;
    call MOD_4;

    multipop(R0,R1,R2,R3);

    return;
endif;

if(R1==4) then
    // Release disk block
    if(R2>0) then
        [DISK_FREE_LIST+R2]=[DISK_FREE_LIST+R2]-1;
    endif;

    return;
endif;

if(R1==GET_FREE_BLOCK) then
    R2=DISK_FREE_AREA;

    // Find free block in user disk region
    while(R2<DISK_SWAP_AREA) do
        if([DISK_FREE_LIST+R2]==0) then
            [DISK_FREE_LIST+R2]=1;
            R0=R2;
            return;
        endif;

        R2=R2+1;
    endwhile;

    // No free block available
    R0=-1;
    return;
endif;

if(R1==GET_SWAP_BLOCK) then
    R1=DISK_SWAP_AREA;

    // Find free block in swap area
    while(R1<DISK_SIZE) do
        if([DISK_FREE_LIST+R1]==0) then
            [DISK_FREE_LIST+R1]=1;
            R0=R1;
            return;
        endif;

        R1=R1+1;
    endwhile;

    // Swap area full
    R0=-1;
    return;
endif;